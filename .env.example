# Copy to `.env` for local development. Never commit the filled-in copy.

# The Firebase project holding the data. Note this is `ticketycustomer` — the
# project every app is configured against. The service-account key previously
# checked in here belonged to `ticketyadmin`, a different project entirely,
# which is why the old endpoints read data nothing else could see.
GOOGLE_CLOUD_PROJECT=ticketycustomer

# Credentials come from Application Default Credentials, not a key file:
#   local:      gcloud auth application-default login
#   Cloud Run:  the runtime service account, automatically
# There is deliberately no variable here pointing at a JSON key.

PORT=3002
LOG_LEVEL=debug

# Browser origins allowed to call the API. Required in production — the server
# refuses to start with an open CORS policy when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
